# Скопіювати в .env на сервері (chmod 600). НІКОЛИ не комітити .env.

# --- Supabase (web + collector) ---
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Тільки для колектора (запис в обхід RLS). Не давати веб-контейнеру зайвого — але
# compose використовує спільний .env, тому web її просто не читає.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Collector ---
SERVER_SERVICE_ID=srv-main
METRIC_RETENTION_DAYS=30

# --- Phase 1–2 (поки не використовуються) ---
# N8N_API_URL=https://n8n.example.com/api/v1
# N8N_API_KEY=
# CLICKUP_API_TOKEN=
# GITHUB_TOKEN=
# OREN_DB_URL=postgres://...   # прямий доступ для supabase-health провайдера
